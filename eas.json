{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "scheme": "gymBeatDataCollection"
      },
      "env": {
        "APPLE_TEAM_ID": "M4M9UUR2NT"
      }
    }
  },
  "submit": {
    "production": {}
  }
}