{
  "expo": {
    "name": "GymBeat",
    "slug": "wearable-workout",
    "owner": "joueph",
    "scheme": "gymbeat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joueph.wearableworkout",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "O GymBeat usa dados do Apple Saude para coletar metricas de treino, batimentos cardiacos e historico de exercicios.",
        "NSHealthUpdateUsageDescription": "O GymBeat pode registrar dados de treino coletados durante suas series."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-health-kit",
      "./plugins/with-watch-app"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba4afad0-f274-4c6d-afe5-3b2dd82288fb",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "WearableWorkoutWatch Watch App",
                  "bundleIdentifier": "com.joueph.wearableworkout.watchkitapp",
                  "entitlements": {
                    "com.apple.developer.healthkit": true,
                    "com.apple.developer.healthkit.background-delivery": true
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
