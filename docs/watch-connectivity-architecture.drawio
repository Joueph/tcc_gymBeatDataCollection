                <mxCell id="legend" value="Fluxo principal&#xa;&#xa;1. Build cria e embute o app do Watch.&#xa;2. iPhone e Watch ativam WCSession.&#xa;3. iPhone envia comandos.&#xa;4. Watch responde estado e metricas.&#xa;5. App armazena a serie coletada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;spacing=12;" parent="data-band" vertex="1">
                    <mxGeometry x="800" y="40" width="460" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="plugin" value="Expo config plugin&#xa;plugins/with-watch-app.js&#xa;&#xa;- copia native/watch-app&#xa;- cria target watchOS&#xa;- adiciona appExtensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#172554;spacing=12;" parent="1" vertex="1">
