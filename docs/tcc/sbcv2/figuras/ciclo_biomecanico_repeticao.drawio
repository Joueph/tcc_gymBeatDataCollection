  <diagram id="ciclo_biomecanico" name="Ciclo Biomecanico Repeticao">
    <mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="600" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Ciclo Biomecânico de uma Repetição e Correspondência no Domínio Inercial" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">  <mxGeometry x="120" y="15" width="720" height="30" as="geometry"/></mxCell>
        <mxCell id="secA" value="(a) Fases Biomecânicas da Execução (Exemplo: Agachamento Livre)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#111111;" parent="1" vertex="1">  <mxGeometry x="200" y="50" width="560" height="25" as="geometry"/></mxCell>
        <mxCell id="box_ecc" value="&lt;b style=&quot;font-size:13px; color:#000000;&quot;&gt;1. FASE EXCÊNTRICA&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; color:#111111;&quot;&gt;Alongamento muscular sob tensão (descida)&lt;br/&gt;Velocidade linear: &lt;i&gt;v(t) &amp;lt; 0&lt;/i&gt;&lt;br/&gt;Duração sob controle: ~1,5 a 2,5 s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=1.5;spacing=8;align=center;" parent="1" vertex="1">  <mxGeometry x="50" y="80" width="250" height="98" as="geometry"/></mxCell>
        <mxCell id="arr1" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="box_ecc" target="box_inf" edge="1">  <mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="box_inf" value="&lt;b style=&quot;font-size:13px; color:#000000;&quot;&gt;2. INFLEXÃO ISOMÉTRICA&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; color:#000000;&quot;&gt;Ponto de reversão (fundo da repetição)&lt;br/&gt;&lt;b&gt;Velocidade linear nula: v(t) = 0&lt;/b&gt;&lt;br/&gt;Inversão instantânea do movimento&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#111111;strokeWidth=2;strokeDashed=1;spacing=8;align=center;" parent="1" vertex="1">  <mxGeometry x="350" y="80" width="250" height="98" as="geometry"/></mxCell>
        <mxCell id="arr2" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="box_inf" target="box_con" edge="1">  <mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="box_con" value="&lt;b style=&quot;font-size:13px; color:#ffffff; background-color:#000000;&quot;&gt;&amp;nbsp;3. FASE CONCÊNTRICA&amp;nbsp;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; color:#000000;&quot;&gt;Contração motora superando a sobrecarga&lt;br/&gt;Velocidade linear: &lt;i&gt;v(t) &amp;gt; 0&lt;/i&gt; (subida)&lt;br/&gt;Impulso motor explosivo: ~0,8 a 1,5 s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;spacing=8;align=center;" parent="1" vertex="1">  <mxGeometry x="650" y="80" width="260" height="98" as="geometry"/></mxCell>
        <mxCell id="secB" value="(b) Sinal Inercial Projetado 1D — p(t) = a(t) · v₁ (com Skewness Positiva γ₁ &gt; 0)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#111111;" parent="1" vertex="1">  <mxGeometry x="150" y="195" width="660" height="25" as="geometry"/></mxCell>
        <mxCell id="graph_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" parent="1" vertex="1">  <mxGeometry x="40" y="225" width="880" height="345" as="geometry"/></mxCell>
        <mxCell id="zone_ecc" value="&lt;b style=&quot;color:#111111;&quot;&gt;Região Excêntrica&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#4b5563;&quot;&gt;Desaceleração controlada sob gravidade&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;strokeWidth=1;strokeDashed=1;align=center;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">  <mxGeometry x="90" y="235" width="265" height="320" as="geometry"/></mxCell>
        <mxCell id="zone_con" value="&lt;b style=&quot;color:#000000;&quot;&gt;Região Concêntrica (Impulso Ascendente)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#111111;&quot;&gt;Aceleração motora ativa superando a carga&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;strokeDashed=1;align=center;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">  <mxGeometry x="375" y="235" width="340" height="320" as="geometry"/></mxCell>
        <mxCell id="peak_lbl" value="&lt;b style=&quot;font-size:11px; color:#000000;&quot;&gt;Crista Concêntrica (Pico)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#000000; font-weight:bold;&quot;&gt;✓ Repetição Validada (Δreps = +1)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;spacing=4;align=center;" parent="1" vertex="1">  <mxGeometry x="460" y="305" width="200" height="42" as="geometry"/></mxCell>
        <mxCell id="val_lbl" value="&lt;b style=&quot;font-size:10px; color:#000000;&quot;&gt;Vale: Inflexão (v = 0)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;strokeDashed=1;spacing=2;align=center;" parent="1" vertex="1">  <mxGeometry x="305" y="520" width="140" height="24" as="geometry"/></mxCell>
        <mxCell id="thresh_lbl" value="Limiar θ_peak (detecção)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9.5;fontColor=#000000;fontStyle=1;align=center;" parent="1" vertex="1">  <mxGeometry x="735" y="341" width="160" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_box" value="&lt;b style=&quot;font-size:10px; color:#000000;&quot;&gt;Legenda Técnica (P&amp;amp;B):&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px; color:#111111;&quot;&gt;— Sinal Projetado 1D &lt;b&gt;p(t)&lt;/b&gt;&lt;br/&gt;- - - Limiar &lt;b&gt;θ_peak&lt;/b&gt;&lt;br/&gt;|---| Bloqueio Refratário&lt;br/&gt;● Pico Validado (FSM)&lt;br/&gt;○ Vale de Inflexão&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;spacing=6;align=left;" parent="1" vertex="1">  <mxGeometry x="730" y="445" width="168" height="102" as="geometry"/></mxCell>
      </root>
