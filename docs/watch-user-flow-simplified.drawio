                <mxCell id="user-stop" value="4. Toca Parar&lt;br&gt;e informa repeticoes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#334155;spacing=10;fontStyle=1;" parent="1" vertex="1">
