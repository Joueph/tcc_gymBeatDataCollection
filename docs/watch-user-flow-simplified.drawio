                <mxCell id="user-start" value="1. Escolhe exercicio&lt;br&gt;e toca Iniciar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#334155;spacing=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="110" y="140" width="210" height="52" as="geometry"/>
