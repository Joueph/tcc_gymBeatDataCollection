                <mxCell id="storage-cloud" value="6. Sincroniza nuvem&lt;br&gt;&lt;br&gt;Firebase recebe o historico quando houver sync." style="cloud;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;spacing=10;" vertex="1" parent="1">
