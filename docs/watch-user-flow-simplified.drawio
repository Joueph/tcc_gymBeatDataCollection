                </mxCell>
                <mxCell id="iphone-session" value="2. iPhone abre sessao&lt;br&gt;&lt;br&gt;Seleciona o exercicio, cria a serie e envia startSession para o Watch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#172554;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="180" y="275" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="iphone-live" value="Recebe amostras&lt;br&gt;&lt;br&gt;Atualiza a tela ao vivo com batimentos, movimento e dados do treino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#172554;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="680" y="275" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="watch-collect" value="3. Watch coleta sensores&lt;br&gt;&lt;br&gt;HealthKit + acelerometro + giroscopio geram MetricSamples." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="455" y="445" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="storage-local" value="5. Salva historico&lt;br&gt;&lt;br&gt;Sessao, exercicio, repeticoes e samples ficam no banco local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;spacing=10;" vertex="1" parent="1">
